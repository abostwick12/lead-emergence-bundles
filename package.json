{
  "name": "lead-emergence-bundles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:marketplace": "vitest run tests/marketplace.test.ts",
    "validate:bundles": "vitest run tests/contracts.test.ts tests/registry.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "4.1.11"
  }
}
